use sakila;
GO
DROP TABLE if EXISTS [dbo].[order]
DROP TABLE if EXISTS [dbo].[customer]



create table [dbo].[customer]
(
	customerId int primary key,
	namn varchar(50),
	land varchar(50)
);

CREATE TABLE [dbo].[order]
(
	orderId int identity(1,1) primary key,
	customerId int,
	orderDatum date,
	orderVärde decimal(10,2),
	--FOREIGN KEY (customerId) REFERENCES dbo.customer(customerId)
);

SELECT 
		c.land AS Land,
		YEAR(orderdatum) AS År, 
		MONTH(orderdatum) AS Månad, 
		SUM(orderVärde) AS TotaltOrderVärde
FROM dbo.order o
	INNER JOIN dbo.customer c ON o.customerId = c.customerId
GROUP BY
		c.land, 
		YEAR(orderDatum), 
		MONTH(orderDatum)
ORDER BY 
		Land ASC, 
		År DESC, 
		Månad DESC;
